# ~/.bash_prompt — Bandit HUD v6 for AlmaLinux
# 🔥 Blade-tuned prompt with Git HUD, emoji paths, SSH indicator, and ghelp()

# Prompt builder function
function set_iconic_prompt() {
  if [ "$UID" -eq 0 ]; then
    USER_COLOR="\[\033[1;31m\]"  # red
  else
    USER_COLOR="\[\033[1;36m\]"  # cyan
  fi

  if [ -n "$SSH_CONNECTION" ]; then
    HOST_COLOR="\[\033[1;35m\]"  # magenta
    SSH_TAG=" 🔏"
  else
    HOST_COLOR="\[\033[1;34m\]"  # blue
    SSH_TAG=" 🔒"
  fi

  local absolute_path="$(pwd -P)"
  local cwd_display="$absolute_path"
  local git_root=""
  local repo_dir=""
  local formatted_path=""

  if git rev-parse --is-inside-work-tree &>/dev/null; then
    git_root="$(git rev-parse --show-toplevel 2>/dev/null)"
    repo_dir="${git_root##*/}"
  fi

  IFS='/' read -ra parts <<< "$cwd_display"
  local depth=0
  for part in "${parts[@]}"; do
    [[ -z "$part" ]] && continue
    case $depth in
      0) emoji="🗂️" ; color="\033[1;33m" ;;
      1) emoji="📁" ; color="\033[1;33m" ;;
      2)
        if [[ "$part" == "$repo_dir" ]]; then
          emoji="📂" ; color="\033[1;35m"
        else
          emoji="📁" ; color="\033[1;33m"
        fi
        ;;
      3) emoji="🗃️" ; color="\033[1;33m" ;;
      *) emoji="🧾" ; color="\033[1;33m" ;;
    esac
    formatted_path+="${emoji}\[${color}\]/$part\[\033[0m\] "
    ((depth++))
  done

  local git_prompt_output
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    git_prompt_output="$(parse_git_status_hud "$repo_dir" 2>/dev/null)"
  else
    git_prompt_output="\033[1;30m🔍 not in Git repo\033[0m"
  fi

  PROMPT_LEFT="\n👤 ${USER_COLOR}\u\[\033[0m\] @ 🖥️  ${HOST_COLOR}\H\[\033[0m\]${SSH_TAG}"
  PROMPT_TIME="\n🕒 \[\033[1;37m\]\A\[\033[0m\] \[$git_prompt_output\]"
  PROMPT_PATH="\n📁 $formatted_path"

  export PS1="${PROMPT_LEFT}${PROMPT_TIME}${PROMPT_PATH}\n\[\033[1;32m\]➔ \[\033[0m\]"
}

# Git HUD
function parse_git_status_hud() {
  git rev-parse --is-inside-work-tree &>/dev/null || return

  local branch status untracked_count modified_count total_dirty dirty delta hash age now icon age_minutes age_color age_display
  local git_root rel_path output last_commit repo_dir="$1"

  branch=$(git symbolic-ref --short HEAD 2>/dev/null)
  status=$(git status --porcelain 2>/dev/null)

  untracked_count=$(echo "$status" | grep '^??' | wc -l)
  modified_count=$(echo "$status" | grep -E '^[ MDA]' | wc -l)
  total_dirty=$((untracked_count + modified_count))
  [[ "$total_dirty" -eq 0 ]] && dirty="✔" || dirty="✘"

  hash=$(git log -1 --format=%h 2>/dev/null)
  last_commit=$(git log -1 --format=%ct 2>/dev/null)
  now=$(date +%s)
  age_minutes=$(((now - last_commit) / 60))

  if [ "$age_minutes" -lt 5 ]; then age_color="32"
  elif [ "$age_minutes" -lt 60 ]; then age_color="33"
  else age_color="31"; fi

  if [ "$age_minutes" -lt 60 ]; then
    age="${age_minutes}m"
  else
    age="$((age_minutes / 60))h"
  fi

  age_display=$(printf "\033[1;%sm⏱ %s\033[0m" "$age_color" "$age")

  git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local real_pwd="$(pwd -P)"
  rel_path="${real_pwd#$git_root}"
  delta="${rel_path#/}"
  [ -z "$delta" ] && delta=""

  case "$branch" in
    main|master) icon="🌿" ;;
    dev|develop) icon="⚙️" ;;
    feature/*) icon="✨" ;;
    hotfix/*) icon="🔥" ;;
    bugfix/*) icon="🐛" ;;
    release/*) icon="🚀" ;;
    *) icon="🌱" ;;
  esac

  output="\033[1m\033[1;32m${icon} [$branch] $dirty 🧪 $untracked_count 🔧 $modified_count 🧼 $total_dirty ⛏️ $hash ${age_display} 🧭 \033[1;35m$repo_dir\033[0m${delta:+/\033[1;33m$delta\033[0m}"
  echo -e "$output"

  [ -n "$TMUX" ] && tmux setenv -g TMUX_GIT_HUD "$output"
}

# Export function on shell start
PROMPT_COMMAND="set_iconic_prompt"

# Source aliases if present
if [ -f "$HOME/.bash_aliases_productivity" ]; then
  source "$HOME/.bash_aliases_productivity"
fi

# ghelp() helper
function ghelp() {
  echo -e "\n\033[1;36m📘 Git & Bash Productivity Aliases\033[0m\n"
  while IFS= read -r line; do
    if [[ $line =~ ^alias[[:space:]]+([^=]+)=\"(.*)\" ]]; then
      name="${BASH_REMATCH[1]}"
      cmd="${BASH_REMATCH[2]}"
      echo -e "👉 $name\n    → $cmd\n"
    fi
  done < "$HOME/.bash_aliases_productivity"
}
